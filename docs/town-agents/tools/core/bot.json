"// garage autoplay bot: teleports the player around (on foot) and drops driven cars into lift capture boxes\n(() => {\n  const g = window.__game;\n  if (window.__bot) clearInterval(window.__bot.id);\n  const log = [];\n  const bot = { log, steps: 0, enabled: true, pads: true };\n  function tick() {\n    if (!bot.enabled) return;\n    bot.steps++;\n    const w = g.world, pl = w.player;\n    if (pl.mode === 'driving' && pl.car) {\n      const lift = w.lifts.list.find((l) => l && l.canCapture);\n      if (lift) { pl.car.pos.x = lift.x; pl.car.pos.z = lift.z + 0.2; }\n      return;\n    }\n    if (pl.mode !== 'foot') return;\n    // 1. cash piles\n    const pile = w.piles.find((p) => p.amount > 0 && p.flying === 0);\n    if (pile) { pl.teleport(pile.trigger.x + 0.3, pile.trigger.z); return; }\n    // 2. pads we can afford\n    if (bot.pads) for (const pad of w.pads.list) if (!pad.done && pad.remaining > 0 && g.state.cash >= pad.remaining) { pl.teleport(pad.pos.x, pad.pos.z); return; }\n    // 3. lifted car that needs parts\n    for (const l of w.lifts.list) {\n      if (!l || !l.isWorkable()) continue;\n      const car = l.car;\n      const carry = pl.stack.items.some((it) => car.findNeed(it.userData.partType, null, true));\n      if (carry || (car.firstReady() && l.phase === 'up')) { pl.teleport(l.workPos.x, l.workPos.z); return; }\n      for (const j of car.jobs) {\n        if (j.state !== 'need' || j.incoming) continue;\n        const st = w.stations.get(j.type);\n        if (st && st.stack.ready > 0 && pl.stack.count < pl.capacity()) { pl.teleport(st.zonePos.x, st.zonePos.z); return; }\n      }\n    }\n    // dump useless parts\n    if (pl.stack.count >= pl.capacity()) { pl.teleport(7.0, -6.4); return; }\n    // 4. waiting car + free lift -> stand in ring (only if no valet)\n    if (!w.staff.valet && w.lifts.freeCount() > 0) {\n      for (const car of w.cars.lane) if (w.cars.isWaiting(car)) { pl.teleport(car.pos.x, car.pos.z - 1.55); return; }\n    }\n    pl.teleport(0, 2.4);\n  }\n  bot.id = setInterval(tick, 120);\n  window.__bot = bot;\n  return 'bot on';\n})();\n"
